{
  "name": "scholarium",
  "version": "2.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Scholarium — multi-agent academic research and writing assistant",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "scholarium": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit false",
    "start": "node dist/cli/index.js",
    "serve": "node --experimental-strip-types --no-warnings -e \"import { ScholariumAPI } from './src/server.ts'; import * as path from 'node:path'; const api = new ScholariumAPI({ port: Number(process.env.PORT ?? 3456), dataDir: path.join(process.cwd(), '.data'), staticDir: path.join(process.cwd(), 'src/frontend') }); await api.start();\"",
    "test:mock": "node --experimental-strip-types --no-warnings src/run-tests.ts",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e-ui",
    "test:e2e-ui": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "build:frontend": "cd frontend && npm run build",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.19",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.5",
    "vitest": "~5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
