{
  "name": "论文撰写小助手",
  "version": "2.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "论文撰写小助手 — 多Agent协同学术论文写作系统 (合并版)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "scholarium": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "serve": "node --experimental-strip-types --no-warnings -e \"import { ScholariumAPI } from './src/server.ts'; import * as path from 'node:path'; const api = new ScholariumAPI({ port: Number(process.env.PORT ?? 3456), dataDir: path.join(process.cwd(), '.data'), staticDir: path.join(process.cwd(), 'src/frontend') }); await api.start();\"",
    "test:mock": "node --experimental-strip-types --no-warnings src/run-tests.ts",
    "test:phase": "node --experimental-strip-types --no-warnings src/phase1b-2-test.ts",
    "test:llm": "node --experimental-strip-types --no-warnings src/llm-e2e.test.ts",
    "test:e2e-frontend": "node --experimental-strip-types --no-warnings src/e2e-test.ts",
    "test:paper": "node --experimental-strip-types --no-warnings src/test-paper-generation.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e-ui": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "build:frontend": "cd frontend && npm run build",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "openai": "^4.50.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.19",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.15.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.4",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
